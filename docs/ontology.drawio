        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Hippokampus — Business Rule Ontology&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666666&quot;&gt;Rules are mined from approved diffs. Every RuleVersion is backed by Evidence and tied to the ChangeSet that introduced, modified or retired it.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1200" height="60" as="geometry" />
        </mxCell>
